# Copy to .env (or set these in your hosting dashboard). Never commit real values.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=bms.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://bms.example.com

# Optional: PostgreSQL (SQLite is used when DB_ENGINE is not set)
# DB_ENGINE=postgresql
# DB_NAME=resilience
# DB_USER=resilience
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
