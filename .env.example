# Copy to .env (or set these in your hosting dashboard). Never commit real values.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=bms.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://bms.example.com

# Optional: PostgreSQL (SQLite is used when DB_ENGINE is not set)
# DB_ENGINE=postgresql
# DB_NAME=resilience
# DB_USER=resilience
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Optional: email for invoices and client messages (leave unset to print emails to the console)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Resilience Security <accounts@example.co.ke>

# Optional: where uploaded files are kept (defaults to the project's media/ folder)
# DJANGO_MEDIA_ROOT=
